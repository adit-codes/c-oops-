#include <iostream>
#include<cmath>
using namespace std;
class MAT{
    int m,n;
    float **p;
    public:
    MAT(){};
    MAT(int row,int column)
    {
        m=row; n=column;
        p=new float*[m];
        for(int i=0;i<m;i++)
        {
            p[i]=new float[n];
        }
    }
    friend ostream & operator <<(ostream &,MAT &);
    friend istream & operator >>(istream &,MAT &);
    MAT operator+(MAT m1);
    MAT operator-(MAT m2);
    MAT operator*(MAT m3);
    bool check_size(MAT m4)
    {
        if((m==m4.m)&&(n==m4.n)) return true;
        else return false;
    }
};
ostream& operator<<(ostream &os,MAT &m1)
{
    for(int i=0;i<m1.m;i++)
    {
      for(int j=0;j<m1.n;j++)
      {
          cout<<m1.p[i][j]<<"\t";
      }
      cout<<endl;
    }
    return os;
}
istream& operator>>(istream &is,MAT &m2)
{
    for(int i=0;i<m2.m;i++)
    {
      for(int j=0;j<m2.n;j++)
      {
          cin>>m2.p[i][j];
      }
    }
    return is;
}
//ADDITION 
MAT MAT::operator +(MAT m1)
{
    if(check_size(m1))
    {
        MAT temp(m,n);
       for(int i=0;i<m;i++)
       {
           for(int j=0;j<n;j++)
           {
               temp.p[i][j]=p[i][j]+m1.p[i][j];
           }
        }
        return temp;
    }
    else
    {
        cout<<"INVALID SIZES";
        MAT temp;
        return temp;
    }
}
MAT MAT::operator -(MAT m1)
{
    if(MAT::check_size(m1))
    {
        MAT temp(m,n);
       for(int i=0;i<m;i++)
       {
           for(int j=0;j<n;j++)
           {
               temp.p[i][j]=p[i][j]-m1.p[i][j];
           }
        }
        return temp;
    }
    else
    {
        cout<<"INVALID SIZES";
        MAT temp;
        return temp;
    }
}
MAT MAT::operator *(MAT m1)
{
    if(n==m1.m)
    {
        MAT temp(m,m1.n);
        for(int i=0;i<m;i++)
        {
           for(int j=0;j<m1.n;j++)
           {
               //CORRECTION 1:(TO AVOID GARBAGE VALUES)
               temp.p[i][j]=0;
               for(int k=0;k<n;k++)
               {
                  temp.p[i][j]+=p[i][k]*m1.p[k][j];
               }
           }
        }
        return temp;
    }
    else
    {
        cout<<"matarix multiplication not possible";
        MAT temp;
        return temp;
    }
}
int main() {
    int r1, c1, r2, c2;

    cout << "Enter rows and columns for Matrix A: ";
    cin >> r1 >> c1;
    MAT A(r1, c1);
    cout << "Enter elements for Matrix A:\n";
    cin >> A;

    cout << "\nEnter rows and columns for Matrix B: ";
    cin >> r2 >> c2;
    MAT B(r2, c2);
    cout << "Enter elements for Matrix B:\n";
    cin >> B;

    cout << "\n--- Matrix A ---\n" << A;
    cout << "\n--- Matrix B ---\n" << B;

    // Test Addition
    cout << "\n--- A + B ---\n";
    MAT C = A + B;
    cout << C;

    // Test Subtraction
    cout << "\n--- A - B ---\n";
    MAT D = A - B;
    cout << D;

    // Test Multiplication
    cout << "\n--- A * B ---\n";
    MAT E = A * B;
    cout << E;

    return 0;
}
